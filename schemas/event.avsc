{
  "type": "record",
  "name": "Event",
  "namespace": "shopper_pipeline",
  "doc": "One recorded shopper action. Source columns are carried as they appear in the dataset; typing and cleaning happen in silver.",
  "fields": [
    {"name": "event_id", "type": "string", "doc": "Stable identity derived from the source file name and CSV record number."},
    {"name": "ingest_path", "type": {"type": "enum", "name": "IngestPath", "symbols": ["stream", "backfill"]}, "doc": "How the event entered the pipeline: replay (stream) or backfill."},
    {"name": "event_time", "type": "string", "doc": "When the shopper acted, in the source format: YYYY-MM-DD HH:MM:SS UTC."},
    {"name": "event_type", "type": {"type": "enum", "name": "EventType", "symbols": ["view", "cart", "remove_from_cart", "purchase"]}},
    {"name": "product_id", "type": "long"},
    {"name": "category_id", "type": ["null", "long"], "default": null},
    {"name": "category_code", "type": ["null", "string"], "default": null},
    {"name": "brand", "type": ["null", "string"], "default": null},
    {"name": "price", "type": ["null", "double"], "default": null},
    {"name": "user_id", "type": "long", "doc": "The shopper."},
    {"name": "user_session", "type": ["null", "string"], "default": null, "doc": "The source session, used only to compare against derived sessions."}
  ]
}
